{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    ":ignoreUnstable",
    "group:allNonMajor"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["README.md"],
      "matchStrings": [
        "docker pull oven/bun:(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "docker container run --rm -it -p 3000:3000 -v ./src:/home/bun/app oven/bun:(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "prompt you to open the project in the bun:(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "oven/bun",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["biome.json"],
      "matchStrings": [
        "https://biomejs.dev/schemas/(?<currentValue>.*)/schema.json"
      ],
      "depNameTemplate": "@biomejs/biome",
      "datasourceTemplate": "npm"
    }
  ]
}
